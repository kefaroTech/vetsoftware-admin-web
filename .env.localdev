# Modo `localdev` (npm run dev:local / build:local). Mismo papel que .env.dev y .env.prod.
#
# Existe como fichero de MODO, y no solo como .env.local, porque .dockerignore excluye
# .env.local del contexto de build: dentro de la imagen no habia ningun fichero que
# definiera VETSOFTWARE_PROFILE=localdev y el guard de vite.config.ts:11 abortaba.
# Solo valores publicos; los overrides privados siguen yendo en .env.local, que gana
# prioridad sobre este en local.
VETSOFTWARE_PROFILE=localdev
VITE_API_URL=http://localhost:8080
