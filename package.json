{
  "name": "vetsoftwarefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite --mode localdev",
    "dev:dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite --mode dev",
    "dev:prod": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite --mode prod",
    "build": "npm run build:prod",
    "build:local": "vue-tsc -b && vite build --mode localdev",
    "build:dev": "vue-tsc -b && vite build --mode dev",
    "build:prod": "vue-tsc -b && vite build --mode prod",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:strict": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss,sass,vue}\"",
    "stylelint:strict": "stylelint \"src/**/*.{css,scss,sass,vue}\" --max-warnings=0",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,sass,vue}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint:strict && npm run stylelint:strict && npm run format:check && npm run api:check",
    "quality:staged": "lint-staged",
    "prepare": "husky",
    "budget": "node scripts/check-bundle-budget.mjs",
    "api:sync": "node scripts/api-types.mjs --sync",
    "api:types": "node scripts/api-types.mjs",
    "api:check": "node scripts/api-types.mjs --check",
    "ds:audit": "node scripts/ds-audit.mjs",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "visual": "playwright test --config=playwright.visual.config.ts",
    "visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "visual:docker": "node scripts/visual-docker.mjs",
    "visual:docker:update": "node scripts/visual-docker.mjs --update-snapshots"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.9.0",
    "@grafana/faro-web-tracing": "^2.9.0",
    "axios": "^1.15.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.3.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.9",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
