{
  // Igual que `tsconfig.vitest.json`, pero para Playwright. `e2e/**` importa
  // código de producción por ruta relativa (`../src/...`), de modo que un
  // cambio de firma en `src/` podía dejar las pruebas de extremo a extremo
  // mintiendo sin que ningún gate lo dijera.
  //
  // Proyecto aparte del de Vitest porque el entorno es otro: aquí `expect` y
  // `test` vienen de `@playwright/test`, no de `vitest`, y mezclarlos en un
  // único programa haría que un import equivocado pasara desapercibido.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": [
    "e2e/**/*.ts",
    // Las declaraciones globales (`grecaptcha`, `vite-env`) no llegan por
    // `import`: hay que listarlas o el programa de pruebas ve un `window`
    // distinto del que ve la aplicación.
    "src/**/*.d.ts"
  ]
}
